  "baglar": [
    {"alt": "geoAci", "ust": "geoUcgenAci", "kullanim": "tam", "gerekce": "Açı kavramları üçgende açıların tamamında kullanılır."},
    {"alt": "geoUcgenAci", "ust": "geoDik", "kullanim": "cok", "gerekce": "Dik üçgende açı hesapları, iç açılar toplamı."},
    {"alt": "geoBenzer", "ust": "geoDik", "kullanim": "cok", "gerekce": "Öklid bağıntıları ve trigonometrik oranlar benzerlikten gelir."},
    {"alt": "tytOran", "ust": "geoBenzer", "kullanim": "cok", "gerekce": "Benzerlik oranı = oran-orantı."},
    {"alt": "tytKok", "ust": "geoDik", "kullanim": "cok", "gerekce": "Pisagor ve özel üçgenlerde köklü sonuçlar (√2, √3)."},
    {"alt": "geoDik", "ust": "geoAlan", "kullanim": "az", "gerekce": "Yükseklik çoğu zaman dik üçgenle bulunur."},
    {"alt": "pOranlar", "ust": "geoAlan", "kullanim": "az", "gerekce": "Alan = ½·a·b·sin C."},
    {"alt": "geoUcgenAci", "ust": "geoAciKenar", "kullanim": "cok", "gerekce": "Büyük açı karşısında büyük kenar."},
    {"alt": "pPisagor", "ust": "geoNokta", "kullanim": "cok", "gerekce": "İki nokta arası uzaklık = Pisagor."},
    {"alt": "geoNokta", "ust": "geoDogru", "kullanim": "cok", "gerekce": "Doğru denklemi noktalarla kurulur."},
    {"alt": "pOranlar", "ust": "geoDogru", "kullanim": "az", "gerekce": "Eğim = tan α."},
    {"alt": "geoAci", "ust": "aytAciOlcu", "kullanim": "cok", "gerekce": "Derece kavramı; radyana geçiş."},
    {"alt": "aytAciOlcu", "ust": "aytEsas", "kullanim": "tam", "gerekce": "Esas ölçü açı ölçüsü üzerine kurulur."},
    {"alt": "pOranlar", "ust": "aytBirim", "kullanim": "tam", "gerekce": "Birim çember, dik üçgendeki oranların genişletilmesidir."},
    {"alt": "aytEsas", "ust": "aytBirim", "kullanim": "cok", "gerekce": "90°'den büyük açıları birim çembere yerleştirme."},
    {"alt": "geoCember", "ust": "aytBirim", "kullanim": "az", "gerekce": "Yarıçap, merkez açı."},
    {"alt": "geoNokta", "ust": "aytBirim", "kullanim": "az", "gerekce": "Noktanın koordinatları (cos x, sin x)."},
    {"alt": "tytKok", "ust": "aytBirim", "kullanim": "az", "gerekce": "Özel açı değerleri köklüdür."},
    {"alt": "aytBirim", "ust": "aytOzdeslik", "kullanim": "tam", "gerekce": "Özdeşlikler oranların tanımlarından çıkar."},
    {"alt": "pPisagor", "ust": "aytOzdeslik", "kullanim": "cok", "gerekce": "sin²x + cos²x = 1."},
    {"alt": "tytCarpan", "ust": "aytOzdeslik", "kullanim": "cok", "gerekce": "Özdeşlik sorularında çarpanlara ayırma, iki kare farkı."},
    {"alt": "aytBirim", "ust": "aytIsaret", "kullanim": "tam", "gerekce": "Bölgelere göre işaret ve sıralama birim çemberden okunur."},
    {"alt": "aytBirim", "ust": "aytDonusum", "kullanim": "tam", "gerekce": "Açı dönüşümleri (indirgeme) birim çember simetrisidir."},
    {"alt": "aytIsaret", "ust": "aytDonusum", "kullanim": "cok", "gerekce": "İndirgemede işaret bölgeye göre belirlenir."},
    {"alt": "aytBirim", "ust": "aytPeriyot", "kullanim": "tam", "gerekce": "Grafik, birim çemberin açılmış hâlidir."},
    {"alt": "aytPeriyodik", "ust": "aytPeriyot", "kullanim": "cok", "gerekce": "Periyot kavramı."},
    {"alt": "aytFonk", "ust": "aytPeriyodik", "kullanim": "cok", "gerekce": "Fonksiyon kavramı."},
    {"alt": "aytFonk", "ust": "aytTers", "kullanim": "cok", "gerekce": "Ters fonksiyon, fonksiyon tanımına dayanır."},
    {"alt": "aytTers", "ust": "aytTersTrig", "kullanim": "cok", "gerekce": "arcsin, arccos ters fonksiyon mantığıdır."},
    {"alt": "aytBirim", "ust": "aytTersTrig", "kullanim": "cok", "gerekce": "Açıyı orandan geri bulma."},
    {"alt": "aytPeriyot", "ust": "aytTersTrig", "kullanim": "az", "gerekce": "Tanım kümesini kısıtlama grafikten görülür."},
    {"alt": "aytBirim", "ust": "aytSinCos", "kullanim": "cok", "gerekce": "Geniş açılı üçgende sin, cos değerleri."},
    {"alt": "pPisagor", "ust": "aytSinCos", "kullanim": "az", "gerekce": "Kosinüs teoremi Pisagor'un genelleşmesidir."},
    {"alt": "aytOzdeslik", "ust": "aytToplamFark", "kullanim": "cok", "gerekce": "Formüller özdeşliklerle sadeleştirilir."},
    {"alt": "aytDonusum", "ust": "aytToplamFark", "kullanim": "az", "gerekce": "Açıları uygun biçime çevirme."},
    {"alt": "aytOzdeslik", "ust": "aytDenklem", "kullanim": "cok", "gerekce": "Denklemi tek orana indirme."},
    {"alt": "aytDonusum", "ust": "aytDenklem", "kullanim": "cok", "gerekce": "Tüm çözümleri bulmak için açı dönüşümleri."},
    {"alt": "aytPeriyot", "ust": "aytDenklem", "kullanim": "cok", "gerekce": "Genel çözüm = kök + k·periyot."},
    {"alt": "aytToplamFark", "ust": "aytDenklem", "kullanim": "az", "gerekce": "İki kat açılı denklemler."},
    {"alt": "aytTersTrig", "ust": "aytDenklem", "kullanim": "az", "gerekce": "Özel olmayan değerlerde çözüm arcsin ile yazılır."},
    {"alt": "tytDenklem", "ust": "aytDenklem", "kullanim": "az", "gerekce": "Yardımcı bilinmeyenle birinci/ikinci derece çözme."},
    {"alt": "pOranlar", "ust": "pBilesen", "kullanim": "tam", "gerekce": "Bileşenler F·cos α ve F·sin α."},
    {"alt": "pPisagor", "ust": "fizVektor", "kullanim": "cok", "gerekce": "Dik bileşenlerden bileşke büyüklüğü."},
    {"alt": "aytSinCos", "ust": "fizVektor", "kullanim": "az", "gerekce": "Bileşke: R² = a² + b² + 2ab·cos θ."},
    {"alt": "fizVektor", "ust": "fizKesisen", "kullanim": "tam", "gerekce": "Kuvvetlerin vektörel toplamı sıfır."},
    {"alt": "aytSinCos", "ust": "fizKesisen", "kullanim": "cok", "gerekce": "Lami teoremi = sinüs teoremi."},
    {"alt": "pBilesen", "ust": "fizTork", "kullanim": "cok", "gerekce": "Kuvvetin dik bileşeni (F·sin α)."},
    {"alt": "pBilesen", "ust": "fizNewton", "kullanim": "cok", "gerekce": "Eğik düzlemde mg·sin α, mg·cos α."},
    {"alt": "tytDenklem", "ust": "fizNewton", "kullanim": "cok", "gerekce": "F = m·a denklemlerini çözme."},
    {"alt": "pBilesen", "ust": "fizAtis", "kullanim": "tam", "gerekce": "Eğik atış: v·cos α yatay, v·sin α düşey."},
    {"alt": "fizNewton", "ust": "fizAtis", "kullanim": "az", "gerekce": "Yer çekimi ivmesiyle hareket."},
    {"alt": "aytToplamFark", "ust": "fizAtis", "kullanim": "az", "gerekce": "Menzil formülünde sin 2α."},
    {"alt": "pBilesen", "ust": "fizIs", "kullanim": "az", "gerekce": "W = F·d·cos θ."},
    {"alt": "fizVektor", "ust": "fizBagil", "kullanim": "cok", "gerekce": "Bağıl hız vektör farkıdır."},
    {"alt": "pOranlar", "ust": "fizKirilma", "kullanim": "az", "gerekce": "Snell yasası (n₁ sin θ₁ = n₂ sin θ₂)."},
    {"alt": "aytBirim", "ust": "fizBHH", "kullanim": "az", "gerekce": "Referans çember, sinüsel konum."}
  ],
