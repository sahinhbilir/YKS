rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /ogretmenler/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;   // yalnızca Firebase konsolundan elle eklenir, bkz. plan §1
    }

    match /ogrenciler/{syncId} {

      function kimlikAlanlariAyni() {
        return request.resource.data.ogretmenUid == resource.data.ogretmenUid
          && request.resource.data.ogrenciNo == resource.data.ogrenciNo
          && request.resource.data.ogrenciAd == resource.data.ogrenciAd
          && request.resource.data.ogrenciSube == resource.data.ogrenciSube
          && request.resource.data.ogrenciBulutId == resource.data.ogrenciBulutId
          && request.resource.data.keys().hasOnly(['ogretmenUid','ogrenciNo','ogrenciAd','ogrenciSube','ogrenciBulutId','bagliUid','paket','sunucuTs','durum','sonrakiSyncId']);
      }
      function yetkiliOgretmen() {
        return request.auth.token.firebase.sign_in_provider != 'anonymous'
          && exists(/databases/$(database)/documents/ogretmenler/$(request.auth.uid));
      }
      // Devre dışı bırakma sırasında, sonrakiSyncId'nin GERÇEKTEN bu işlemle birlikte
      // YENİ oluşturulan, aynı öğretmen/öğrenciye ait, aktif bir belgeyi gösterdiğini
      // doğrular. Saldırganlar zaten kimlikAlanlariAyni()/yetkiliOgretmen() ile
      // engelleniyor — bu, hatalı istemci kodunun bozuk bir zincir yazmasına karşı
      // ekstra bir güvence. !exists() belgenin transaction ÖNCESİ var olmadığını
      // kanıtlar — yani bu belgenin YAZILMASI zorunlu olarak "create" kuralından geçer,
      // ve o kural zaten bagliUid==null/paket==null/durum=='aktif' şartlarını kendi
      // başına dayatır — burada onları tekrarlamaya gerek yok.
      function sonrakiGecerli() {
        let yeniYol = /databases/$(database)/documents/ogrenciler/$(request.resource.data.sonrakiSyncId);
        let sonraki = getAfter(yeniYol).data;
        return !exists(yeniYol)
          && sonraki.durum == 'aktif'
          && sonraki.ogretmenUid == resource.data.ogretmenUid
          && sonraki.ogrenciNo == resource.data.ogrenciNo
          && sonraki.ogrenciAd == resource.data.ogrenciAd
          && sonraki.ogrenciSube == resource.data.ogrenciSube
          && sonraki.ogrenciBulutId == resource.data.ogrenciBulutId;
      }

      allow create: if request.auth != null && yetkiliOgretmen()
        && request.auth.uid == request.resource.data.ogretmenUid
        && request.resource.data.bagliUid == null
        && request.resource.data.paket == null
        && request.resource.data.durum == 'aktif'
        && request.resource.data.keys().hasOnly(['ogretmenUid','ogrenciNo','ogrenciAd','ogrenciSube','ogrenciBulutId','bagliUid','paket','sunucuTs','durum'])
        && request.resource.data.ogrenciAd is string && request.resource.data.ogrenciAd.size() <= 100
        && request.resource.data.ogrenciBulutId is string && request.resource.data.ogrenciBulutId.size() > 0;

      // İlk ayırmada istemci rastgele ürettiği syncId'nin boş olduğunu getDoc() ile
      // denetler. Olmayan belgede resource.data yoktur; allowlist'teki öğretmene yalnızca
      // bu "yok" sonucunu okumaya izin vermezsek güvenli create akışı hiç başlayamaz.
      // Mevcut belgelerde ise öğretmen hâlâ yalnızca KENDİ belgesini okuyabilir. list
      // izni verilmez; başka öğretmenlerin belgeleri taranamaz.
      // Devre dışı bırakılmış bir yuvayı öğrenci okuyamaz; eski cihaz sonrakiSyncId'yi
      // öğrenemez. Öğretmen erişimi allowlist'e bağlı kalır.
      allow get: if request.auth != null &&
        ((yetkiliOgretmen() &&
            (!exists(/databases/$(database)/documents/ogrenciler/$(syncId)) ||
              request.auth.uid == resource.data.ogretmenUid))
          || (request.auth.uid == resource.data.bagliUid && resource.data.durum == 'aktif'));

      allow update: if request.auth != null && kimlikAlanlariAyni() && (
        (
          resource.data.durum == 'aktif'
          && !('sonrakiSyncId' in request.resource.data)   // yalnızca devre dışı bırakma dalı bunu yazabilir
          // Üretimde öğrenci cihazları HER ZAMAN anonim oturum açar (girisOgrenci()) — bunu
          // burada da zorunlu kılmak, olası bir istemci hatasının (örn. paylaşılan auth
          // örneğinde kalan gerçek bir hesabın) bu belgeyi hiç yazamamasını garantiler.
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && ((resource.data.bagliUid == null && request.resource.data.bagliUid == request.auth.uid)
            || (resource.data.bagliUid == request.auth.uid && request.resource.data.bagliUid == resource.data.bagliUid))
          && request.resource.data.durum == 'aktif'
          && request.resource.data.paket.tur == 'yks-sonuc'
          && request.resource.data.paket.kayit is list
          && request.resource.data.paket.kayit.size() <= 5000
          && (!('konular' in request.resource.data.paket) || request.resource.data.paket.konular.size() <= 2000)
        )
        ||
        (
          // Devre dışı bırakma (syncId rotasyonunun bir adımı): yalnızca durum ve
          // sonrakiSyncId değişir; bagliUid (denetim için) ve paket (öğretmen zaten
          // transaction içinde okudu) dokunulmaz.
          request.auth.uid == resource.data.ogretmenUid && yetkiliOgretmen()
          && resource.data.durum == 'aktif' && request.resource.data.durum == 'iptal'
          && request.resource.data.sonrakiSyncId is string
          && request.resource.data.bagliUid == resource.data.bagliUid
          && request.resource.data.paket == resource.data.paket
          && sonrakiGecerli()
        )
      );

      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
