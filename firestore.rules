rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bu blokta tanımlı olduğu için aşağıdaki bütün match'lerden görülür.
    function yetkiliOgretmen() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/ogretmenler/$(request.auth.uid));
    }

    match /ogretmenler/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;   // yalnızca Firebase konsolundan elle eklenir, bkz. plan §1
    }

    // Öğretmenin kendi defterinin tamamı (yedek JSON'u), YALNIZCA kendi UID'si altında.
    // Başka bir öğretmen, öğrenci ya da anonim oturum bu belgeye erişemez; listeleme
    // izni yoktur, silme kapalıdır (yanlışlıkla ya da kötü niyetle yedek yok edilemesin —
    // üzerine yazmak için bile allowlist'te olmak gerekir).
    match /ogretmenYedek/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid && yetkiliOgretmen();
      allow create, update: if request.auth != null && request.auth.uid == uid && yetkiliOgretmen()
        && request.resource.data.keys().hasOnly(['veri','ts','surum','boyut'])
        && request.resource.data.veri is string
        && request.resource.data.veri.size() > 0
        && request.resource.data.veri.size() <= 900000
        && request.resource.data.ts is int;
      allow delete: if false;
    }

    // Günlük anlık görüntüler: her gün için bir belge, kimliği o günün tarihi (YYYY-AA-GG).
    // Amaç bir güvenlik önlemi değil, GERİ ALMA yeteneği: bir sonuç yanlış girilir ya da
    // bozulursa öğretmen önceki bir güne dönebilir. Silme kapalıdır ki geçmiş, üzerine
    // yazılarak ya da temizlenerek kaybolmasın; yalnızca o günün belgesi tazelenir.
    match /ogretmenYedek/{uid}/gecmis/{gun} {
      allow get, list: if request.auth != null && request.auth.uid == uid && yetkiliOgretmen();
      allow create, update: if request.auth != null && request.auth.uid == uid && yetkiliOgretmen()
        && request.resource.data.keys().hasOnly(['veri','ts','surum','boyut','ogrenciSayisi','sonucSayisi'])
        && request.resource.data.veri is string
        && request.resource.data.veri.size() > 0
        && request.resource.data.veri.size() <= 900000
        && request.resource.data.ts is int;
      allow delete: if false;
    }

    // Bir günlük yedek geri yüklenmeden hemen önce açık olan defter burada benzersiz
    // bir belge olarak saklanır. Günlük kopyadan farklı olarak üzerine yazılamaz: geri
    // yüklemenin ardından çalışan otomatik yedek bu koruma noktasını yok edemez.
    match /ogretmenYedek/{uid}/geriNoktalari/{noktaId} {
      function geriNoktasiGecerli() {
        return request.resource.data.keys().hasOnly(
            ['veri','ts','surum','boyut','ogrenciSayisi','sonucSayisi','kaynak'])
          && request.resource.data.veri is string
          && request.resource.data.veri.size() > 0
          && request.resource.data.veri.size() <= 900000
          && request.resource.data.ts is int
          && request.resource.data.ts > 0
          && request.resource.data.surum is int
          && request.resource.data.surum > 0
          && request.resource.data.boyut is int
          && request.resource.data.boyut > 0
          && request.resource.data.boyut <= 900000
          && request.resource.data.ogrenciSayisi is int
          && request.resource.data.ogrenciSayisi >= 0
          && request.resource.data.sonucSayisi is int
          && request.resource.data.sonucSayisi >= 0
          && request.resource.data.kaynak is string
          && request.resource.data.kaynak.size() > 0
          && request.resource.data.kaynak.size() <= 100;
      }
      allow get, list: if request.auth != null && request.auth.uid == uid && yetkiliOgretmen();
      allow create: if request.auth != null && request.auth.uid == uid && yetkiliOgretmen()
        && geriNoktasiGecerli();
      allow update, delete: if false;
    }

    // Rehber öğretmenin önceden hazırladığı öğrenci hesabı. Paket JSON dizesi olarak
    // saklanır; böylece iç içe diziler Firestore belge biçimini bozmaz. Öğrenci yalnızca
    // Firebase Authentication tarafından doğrulanan kendi UID belgesini okuyabilir.
    match /ogrenciHesaplari/{uid} {
      function hesapBelgesiGecerli() {
        return request.resource.data.keys().hasOnly(['veri','syncId','aktif','ts','surum'])
          && request.resource.data.veri is string
          && request.resource.data.veri.size() > 0
          && request.resource.data.veri.size() <= 900000
          && request.resource.data.syncId is string
          && request.resource.data.syncId.size() > 0
          && request.resource.data.aktif is bool
          && request.resource.data.ts is int
          && request.resource.data.surum is int;
      }
      allow get: if request.auth != null && request.auth.uid == uid && resource.data.aktif == true;
      allow create, update: if yetkiliOgretmen() && hesapBelgesiGecerli();
      allow delete, list: if false;
    }

    match /ogrenciler/{syncId} {

      function kimlikAlanlariAyni() {
        return request.resource.data.ogretmenUid == resource.data.ogretmenUid
          && request.resource.data.ogrenciNo == resource.data.ogrenciNo
          && request.resource.data.ogrenciAd == resource.data.ogrenciAd
          && request.resource.data.ogrenciSube == resource.data.ogrenciSube
          && request.resource.data.ogrenciBulutId == resource.data.ogrenciBulutId
          && request.resource.data.keys().hasOnly(['ogretmenUid','ogrenciNo','ogrenciAd','ogrenciSube','ogrenciBulutId','bagliUid','paket','sunucuTs','istemciOlay','durum','sonrakiSyncId']);
      }
      // Devre dışı bırakma sırasında, sonrakiSyncId'nin GERÇEKTEN bu işlemle birlikte
      // YENİ oluşturulan, aynı öğretmen/öğrenciye ait, aktif bir belgeyi gösterdiğini
      // doğrular. Saldırganlar zaten kimlikAlanlariAyni()/yetkiliOgretmen() ile
      // engelleniyor — bu, hatalı istemci kodunun bozuk bir zincir yazmasına karşı
      // ekstra bir güvence. !exists() belgenin transaction ÖNCESİ var olmadığını
      // kanıtlar — yani bu belgenin YAZILMASI zorunlu olarak "create" kuralından geçer,
      // ve o kural zaten bagliUid==null/paket==null/durum=='aktif' şartlarını kendi
      // başına dayatır — burada onları tekrarlamaya gerek yok.
      function sonrakiGecerli() {
        let yeniYol = /databases/$(database)/documents/ogrenciler/$(request.resource.data.sonrakiSyncId);
        let sonraki = getAfter(yeniYol).data;
        return !exists(yeniYol)
          && sonraki.durum == 'aktif'
          && sonraki.ogretmenUid == resource.data.ogretmenUid
          && sonraki.ogrenciNo == resource.data.ogrenciNo
          && sonraki.ogrenciAd == resource.data.ogrenciAd
          && sonraki.ogrenciSube == resource.data.ogrenciSube
          && sonraki.ogrenciBulutId == resource.data.ogrenciBulutId;
      }

      function yayinlanmisHesap(uid) {
        let hesapYolu = /databases/$(database)/documents/ogrenciHesaplari/$(uid);
        return exists(hesapYolu)
          && get(hesapYolu).data.aktif == true
          && get(hesapYolu).data.syncId == syncId;
      }

      // Planı başlatma ve sonuç kaydetme ayrıca bir onay istemeden senkronizasyonu
      // tetikler. Paket dışında duran bu küçük olay alanı, boş bir yerel geçmişin
      // sunucudaki sonuç paketini silmesine gerek kalmadan son işlemi kaydeder.
      function istemciOlayGecerli() {
        return !('istemciOlay' in request.resource.data)
          || (
            request.resource.data.istemciOlay is map
            && request.resource.data.istemciOlay.keys().hasOnly(['tur','hafta','ts','toplam'])
            && (request.resource.data.istemciOlay.tur == 'plan-baslatildi'
              || request.resource.data.istemciOlay.tur == 'sonuclar-kaydedildi')
            && request.resource.data.istemciOlay.hafta is int
            && request.resource.data.istemciOlay.ts is int
            && (!('toplam' in request.resource.data.istemciOlay)
              || (request.resource.data.istemciOlay.toplam is int
                && request.resource.data.istemciOlay.toplam >= 0
                && request.resource.data.istemciOlay.toplam <= 5000))
          );
      }

      allow create: if request.auth != null && yetkiliOgretmen()
        && request.auth.uid == request.resource.data.ogretmenUid
        && (request.resource.data.bagliUid == null
          || (request.resource.data.bagliUid is string
            && yayinlanmisHesap(request.resource.data.bagliUid)))
        && request.resource.data.paket == null
        && request.resource.data.durum == 'aktif'
        && request.resource.data.keys().hasOnly(['ogretmenUid','ogrenciNo','ogrenciAd','ogrenciSube','ogrenciBulutId','bagliUid','paket','sunucuTs','durum'])
        && request.resource.data.ogrenciAd is string && request.resource.data.ogrenciAd.size() <= 100
        && request.resource.data.ogrenciBulutId is string && request.resource.data.ogrenciBulutId.size() > 0;

      // İlk ayırmada istemci rastgele ürettiği syncId'nin boş olduğunu getDoc() ile
      // denetler. Olmayan belgede resource.data yoktur; allowlist'teki öğretmene yalnızca
      // bu "yok" sonucunu okumaya izin vermezsek güvenli create akışı hiç başlayamaz.
      // Mevcut belgelerde ise öğretmen hâlâ yalnızca KENDİ belgesini okuyabilir. list
      // izni verilmez; başka öğretmenlerin belgeleri taranamaz.
      // Devre dışı bırakılmış bir yuvayı öğrenci okuyamaz; eski cihaz sonrakiSyncId'yi
      // öğrenemez. Öğretmen erişimi allowlist'e bağlı kalır.
      allow get: if request.auth != null &&
        ((yetkiliOgretmen() &&
            (!exists(/databases/$(database)/documents/ogrenciler/$(syncId)) ||
              request.auth.uid == resource.data.ogretmenUid))
          || (request.auth.uid == resource.data.bagliUid && resource.data.durum == 'aktif'));

      allow update: if request.auth != null && kimlikAlanlariAyni() && (
        (
          resource.data.durum == 'aktif'
          && !('sonrakiSyncId' in request.resource.data)   // yalnızca devre dışı bırakma dalı bunu yazabilir
          // Eski dosya-paketi akışındaki cihaz anonim oturum açar. Yeni ad+numara akışında
          // ise parola sağlayıcılı hesabın hem bu yuvaya bağlı olması hem de aynı syncId'yi
          // taşıyan etkin ogrenciHesaplari belgesine sahip olması gerekir.
          && (
            (request.auth.token.firebase.sign_in_provider == 'anonymous'
              && ((resource.data.bagliUid == null && request.resource.data.bagliUid == request.auth.uid)
                || (resource.data.bagliUid == request.auth.uid
                  && request.resource.data.bagliUid == resource.data.bagliUid)))
            ||
            (request.auth.token.firebase.sign_in_provider == 'password'
              && resource.data.bagliUid == request.auth.uid
              && request.resource.data.bagliUid == resource.data.bagliUid
              && yayinlanmisHesap(request.auth.uid))
          )
          && request.resource.data.durum == 'aktif'
          && (
            request.resource.data.paket == resource.data.paket
            || (
              request.resource.data.paket is map
              && request.resource.data.paket.tur == 'yks-sonuc'
              && request.resource.data.paket.kayit is list
              && request.resource.data.paket.kayit.size() <= 5000
              && (!('konular' in request.resource.data.paket) || request.resource.data.paket.konular.size() <= 2000)
            )
          )
          && istemciOlayGecerli()
        )
        ||
        (
          // Devre dışı bırakma (syncId rotasyonunun bir adımı): yalnızca durum ve
          // sonrakiSyncId değişir; bagliUid (denetim için) ve paket (öğretmen zaten
          // transaction içinde okudu) dokunulmaz.
          request.auth.uid == resource.data.ogretmenUid && yetkiliOgretmen()
          && resource.data.durum == 'aktif' && request.resource.data.durum == 'iptal'
          && request.resource.data.sonrakiSyncId is string
          && request.resource.data.bagliUid == resource.data.bagliUid
          && request.resource.data.paket == resource.data.paket
          && sonrakiGecerli()
        )
        ||
        (
          // Öğretmen, ad+numara hesabını yayınlarken mevcut yuvayı o hesabın UID'sine
          // bağlayabilir. Yalnızca bagliUid değişebilir ve hedef hesabın bu syncId için
          // önceden yayınlanmış olması zorunludur.
          request.auth.uid == resource.data.ogretmenUid && yetkiliOgretmen()
          && resource.data.durum == 'aktif' && request.resource.data.durum == 'aktif'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bagliUid'])
          && request.resource.data.bagliUid is string
          && yayinlanmisHesap(request.resource.data.bagliUid)
        )
      );

      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
